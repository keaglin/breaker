{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@packages/*": ["packages/*"],
      "@ui/*": ["apps/web/src/ui/*"],
      "@web/*": ["apps/web/*"],
      "@api/*": ["apps/api/*"]
    }
  }
}
