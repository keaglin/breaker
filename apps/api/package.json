{
  "name": "@breaker/api",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "lint": "eslint src",
    "db:migrate": "bun run drizzle-kit generate",
    "db:push": "bun run drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:pull": "bun run drizzle-kit introspect",
    "miniflux:sync": "bun run drizzle-kit introspect --config=services/miniflux/drizzle.config.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/stopword": "^2.0.3",
    "drizzle-kit": "^0.24.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/sentry": "^1.2.0",
    "@hono/swagger-ui": "^0.4.0",
    "@hono/zod-openapi": "^0.15.3",
    "axios": "^1.7.4",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.7",
    "playwright": "^1.46.1",
    "postgres": "^3.4.4",
    "stopword": "^3.1.1",
    "ulid": "^2.3.0",
    "zod": "^3.23.8"
  }
}
