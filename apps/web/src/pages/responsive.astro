---
import ReaderComponent from "@/components/reader-responsive.tsx"
import '@/styles/globals.css'

const rawFeeds = await fetch('http://localhost:3000/api/feeds').then(res => res.json())
const rawArticles = await fetch('http://localhost:3000/api/entries').then(res => res.json())

// Transform feeds
const feeds = rawFeeds.map(feed => ({
  id: feed.id,
  name: feed.title.toUpperCase(),
  unread: rawArticles.filter(article => article.feedId === feed.id && article.status === 'unread').length,
  url: feed.siteUrl
}));

console.log('feeds', feeds[0])

// Transform articles
const articles = rawArticles.map(article => ({
  id: article.id,
  feedId: article.feedId,
  title: article.title,
  content: article.content,
  date: new Date(article.lastSyncedAt).toISOString().split('T')[0], // Format date as YYYY-MM-DD
  rawContent: article.content,
  summary: article.summary || "No summary available.",
  keyPoints: article.keypoints ? article.keypoints : ["No key points available."],
  takeaways: article.takeaways ? article.takeaways : ["No takeaways available."]
}));
---
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reader</title>
</head>
<body>
    <ReaderComponent client:load feeds={feeds} articles={articles} />
</body>
</html>
